#!/usr/bin/env python3
import asyncio

import broadlink_async
from broadlink_async import FanMode, lifaair


def print_state(state: dict):
    temperature = state["temperature"]
    humidity = state["humidity"]
    fan_speed = state["fan_speed"]
    print(
        "-> Temperature=%s Humidity=%s CO2=%4dppm HCHO=%4.2fmg/m3 "
        "TVOC=%4dug/m3 PM1=%2d PM2.5=%2d PM10=%2d FanSpeed=%s (%s) online=%s"
        % (
            "%2.1fC" % temperature if temperature is not None else "-----",
            "%2d%%" % humidity if humidity is not None else "---",
            state["co2"],
            state["formaldehyde"],
            state["tvoc"],
            state["pm1"],
            state["pm2_5"],
            state["pm10"],
            "%d" % fan_speed if fan_speed is not None else "---",
            state["fan_mode"],
            state["purifier_online"],
        )
    )


async def main():
    print("Searching for lifaair devices... ")
    devices = await broadlink_async.discover()
    dev: lifaair = next(d for d in devices if isinstance(d, lifaair))
    print("Found %s" % dev)

    async with dev:
        print("Authenticating... ", end="")
        await dev.auth()
        print("OK (id=%d, key=%s)" % (dev.id, dev.aes.algorithm.key.hex()))

        print("Getting firmware version... ", end="")
        print(await dev.get_fwversion())

        print("Getting state...")
        print_state(await dev.get_state())

        print(
            "While OFF, modes other than OFF and AUTO are rejected with "
            "error -5 and nothing changes."
        )
        for mode in FanMode:
            if mode in (FanMode.MANUAL, FanMode.UNKNOWN):
                continue
            print("Setting fan mode to %s" % mode)
            print_state(await dev.set_fan_mode(mode))
            await asyncio.sleep(5)

        for speed in (0, 60, 121):
            print("Setting fan speed to %d" % speed)
            print_state(await dev.set_fan_speed(speed))
            await asyncio.sleep(5)

        print("Monitoring state...")
        while True:
            print_state(await dev.get_state())
            await asyncio.sleep(1)


if __name__ == "__main__":
    asyncio.run(main())
